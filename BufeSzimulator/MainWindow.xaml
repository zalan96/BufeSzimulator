<Window x:Class="BufeSzimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BufeSzimulator"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="130"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#8B4513" CornerRadius="12" Padding="15">
            <TextBlock Text="🥪 BüféSzimulátor"
                       Foreground="White"
                       FontSize="30"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,15,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="15" Margin="0,0,15,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Termékek"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <ListBox x:Name="lbTermekek"
                             Grid.Row="1"
                             FontSize="18"/>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Margin="0,10,0,0">
                        <Button Content="Vásárlás"
                                Width="120"
                                Height="40"
                                Margin="0,0,10,0"/>

                        <Button Content="Részletek"
                                Width="120"
                                Height="40"
                                Margin="0,0,10,0"/>

                        <Button Content="Kilépés"
                                Width="100"
                                Height="40"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="15">
                <StackPanel>
                    <TextBlock Text="Vásárló adatai"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock x:Name="txtPenz"
                               FontSize="18"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="txtElkoltott"
                               FontSize="18"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="txtDarab"
                               FontSize="18"
                               Margin="0,0,0,10"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Megvásárolt termékek"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <ListBox x:Name="lbVasarlasok"
                         Grid.Row="1"
                         FontSize="16"/>
            </Grid>
        </Border>
    </Grid>
</Window>
